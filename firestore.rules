rules_version = '2';

/*
 * 잼통 Firestore 규칙.
 *
 * 기본 규칙은 하나다: 자기 것만 읽고 쓴다.
 *
 * 이력이 users/{uid} 아래 있는 이유가 이것이다. 최상위에 두고 필드로 주인을
 * 가리면 목록 조회마다 그 필드를 검사해야 하고, 검사를 한 군데 빠뜨리면 남의
 * 기록이 열린다. 경로로 가르면 빠뜨릴 자리가 없다.
 *
 * 익명 계정도 uid를 가지므로 같은 규칙이 그대로 적용된다.
 *
 * ★ 예외가 여럿 있다: feedback, cheerVideos, cheerNotes, infographics, 정원의 공유 상태(plaza*·blooms·leafChecks).
 *   앞의 셋과 정원의 공유 상태는 누구나 읽고, 인포그래픽은 승인된 것만 누구나 읽는다.
 *   공개인 것이 기능이기 때문이다 — 남이 무엇을 남겼는지 보이지 않으면
 *   같은 말이 계속 쌓이고, 응원판은 아예 성립하지 않는다. 그래서 여기만
 *   경로로 가르지 못하고 필드와 모양을 일일이 검사한다. 예외를 하나 두면
 *   검사가 얼마나 늘어나는지를 이 파일이 그대로 보여 준다.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /**
     * '나도요'로 인한 카운터 변화인가.
     *
     * agreeCount 한 칸만 움직여야 하고, 그 방향이 이 커밋에서 agrees 문서가
     * 생겼는지 지워졌는지와 맞아야 한다. 짝을 맞추지 않으면 카운터만 올리는
     * 요청이 통과한다.
     *
     * 표시 문서의 경로를 인자로 받는다. 피드백과 응원이 같은 모양을 쓰므로,
     * 컬렉션 이름을 안에 박아 두면 두 벌이 생기고 둘 중 하나는 반드시 덜
     * 검사된다. 이 불변식은 한 군데에만 있어야 한다.
     */
    function isAgreeDelta(agreePath) {
      let before = resource.data.agreeCount;
      let after = request.resource.data.agreeCount;
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agreeCount'])
        && (
          (after == before + 1 && !exists(agreePath) && existsAfter(agreePath))
          || (after == before - 1 && exists(agreePath) && !existsAfter(agreePath))
        );
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /asks/{askId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;

        // 만들 때만 모양을 본다. 이력은 고치는 것이 아니라 쌓고 지우는 것이다.
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.question is string
          && request.resource.data.question.size() <= 500
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 4000
          && request.resource.data.achievementSlug is string
          && request.resource.data.grounded is bool;

        allow update: if false;
      }

      /*
       * 개인 정원 (docs/garden-game.md). 한 문서에 다 담는다.
       * 잼은 이 정원 안에서만 쓰이고 거래도 없으므로 값의 정직성은 보지 않는다.
       * 모양과 크기만 본다 — 문서가 끝없이 커지지 않게.
       */
      match /garden/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && docId == 'state'
          && request.resource.data.jam is number
          && request.resource.data.beds is list
          && request.resource.data.beds.size() <= 12
          && request.resource.data.basket is list
          && request.resource.data.basket.size() <= 120
          && request.resource.data.notes is list
          && request.resource.data.notes.size() <= 2000;
      }
    }

    /*
     * 광장 — 모두가 함께 쓰는 정원 (docs/garden-game.md §3.8).
     *
     * ★ 누구나 읽는다. 잡초가 모두에게 보여야 함께 치울 수 있다.
     *
     * ★ 칸에는 누가 뽑았는지 남기지 않는다.
     *
     * 규칙이 지키는 불변식은 셋이다.
     *   1. 없는 잡초는 뽑지 못한다 — 직전 regrowAt이 지났어야 한다.
     *   2. 다시 나는 시각은 [15, 245]분 뒤다. 화면은 [20, 240]분을 고르고,
     *      양쪽 5분은 기기 시계가 어긋난 몫이다.
     *   3. 기록판은 같은 커밋에서 실제로 뽑힌 칸과 짝이 맞을 때만 한 칸 오른다.
     *      정원지기 수는 표식 문서가 이 커밋에서 처음 생길 때만 오른다.
     */
    match /plazaCells/{cell} {
      allow read: if true;
      allow create, update: if request.auth != null
        && cell.matches('^c[0-9]{2}$')
        && int(cell.split('c')[1]) < 24
        && request.resource.data.keys().hasOnly(['gen', 'pulledAt', 'regrowAt'])
        && request.resource.data.pulledAt == request.time
        && request.resource.data.gen == (resource == null ? 1 : resource.data.gen + 1)
        && (resource == null || resource.data.regrowAt <= request.time)
        && request.resource.data.regrowAt >= request.time + duration.value(15, 'm')
        && request.resource.data.regrowAt <= request.time + duration.value(245, 'm');
      allow delete: if false;
    }

    /*
     * 꽃밭 — 업적을 함께 피우고, 가장 많이 가꾼 사람이 정원지기가 된다
     * (docs/garden-game.md §3.9).
     *
     * 정원지기는 경쟁하는 공개 자리라 값을 규칙이 본다.
     *   1. 내 가꿈은 한 번에 1~2, 한 업적에 하루(한국 날짜) 12까지 오른다.
     *   2. 합계는 같은 커밋에서 내 가꿈이 오른 만큼만 오른다.
     *   3. 만개 시각은 합계가 30을 넘는 커밋에서 한 번만 찍히고 다시 바뀌지 않는다.
     *   4. 정원지기는 나로만 바뀌고, 그때 값은 내 가꿈이며, 지금 정원지기보다 많아야 한다.
     *      이미 내가 정원지기면 값만 따라 오른다.
     * 운영자는 정원 이름이 부적절하면 지울 수 있다(ownerNick → null). 지운 이름은
     * hiddenNick에 남고, 그 이름으로는 다시 걸 수 없다 — 다음 가꿈에서 같은 이름이
     * 되살아나지 않게. 정원지기는 이름을 바꾸면 다시 걸 수 있다.
     */
    function kstDayNumber() {
      return math.floor((request.time.toMillis() + 32400000) / 86400000);
    }

    match /blooms/{speciesId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && speciesId.matches('^a:[a-z0-9-]+$')
        && request.resource.data.keys().hasOnly(['care', 'bloomedAt', 'ownerUid', 'ownerNick', 'ownerCare', 'hiddenNick'])
        && request.resource.data.get('hiddenNick', null) == (resource == null ? null : resource.data.get('hiddenNick', null))
        && bloomCareDelta(speciesId)
        && bloomStamp()
        && bloomOwner(speciesId);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerNick', 'hiddenNick'])
        && resource.data.ownerNick is string
        && request.resource.data.ownerNick == null
        && request.resource.data.hiddenNick == resource.data.ownerNick;

      allow delete: if false;

      match /keepers/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['care', 'day', 'dayCare', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.day == kstDayNumber()
          && keeperDelta() >= 1
          && keeperDelta() <= 2
          && request.resource.data.dayCare
            == (resource != null && resource.data.day == kstDayNumber() ? resource.data.dayCare : 0) + keeperDelta()
          && request.resource.data.dayCare <= 12;
        allow delete: if false;
      }
    }

    function keeperDelta() {
      return request.resource.data.care - (resource == null ? 0 : resource.data.care);
    }

    function keeperPath(speciesId) {
      return /databases/$(database)/documents/blooms/$(speciesId)/keepers/$(request.auth.uid);
    }

    function myCareAfter(speciesId) {
      return getAfter(keeperPath(speciesId)).data.care;
    }

    function myCareBefore(speciesId) {
      return exists(keeperPath(speciesId)) ? get(keeperPath(speciesId)).data.care : 0;
    }

    function bloomCareDelta(speciesId) {
      return request.resource.data.care
        == (resource == null ? 0 : resource.data.care) + (myCareAfter(speciesId) - myCareBefore(speciesId));
    }

    function bloomStamp() {
      let before = resource == null ? null : resource.data.bloomedAt;
      let after = request.resource.data.bloomedAt;
      return before != null
        ? after == before
        : (request.resource.data.care >= 30 ? after == request.time : after == null);
    }

    function bloomOwner(speciesId) {
      let d = request.resource.data;
      let unchanged = resource != null
        && d.ownerUid == resource.data.ownerUid
        && d.ownerNick == resource.data.ownerNick
        && d.ownerCare == resource.data.ownerCare;
      let mine = d.ownerUid == request.auth.uid
        && d.ownerCare == myCareAfter(speciesId)
        && (d.ownerNick == null
          || (d.ownerNick is string
            && d.ownerNick.size() >= 1
            && d.ownerNick.size() <= 12
            && d.ownerNick != d.get('hiddenNick', null)))
        && (resource == null
          || resource.data.ownerUid == request.auth.uid
          || d.ownerCare > resource.data.ownerCare);
      return unchanged || mine;
    }

    /*
     * 거대 잡초 — 광장이 무성해지면 나타나는 레이드 (docs/garden-game.md §3.8).
     *
     * plazaRaids/{한국 날짜 번호}-{물결}   하루 세 마리까지. 체력(hp)·태어난 때·쓰러진 때.
     *   ├ shards/{0–7}                    맞은 수(hits)·참여 인원(fighters)을 나눠 센다. 누구나 읽는다.
     *   └ fighters/{uid}                  한 사람이 이 물결에 때린 수와 올리는 칸. 본인만 읽는다.
     *
     * 규칙이 지키는 것. 값은 src/features/garden/rules.ts의 RAID_*와 같다(rules.test.ts가 본다).
     *   1. 오늘 번호로만, 물결 1–3으로, 체력 [180, 3000]으로, 맞은 수 0에서 태어난다.
     *   2. 2·3번째 물결은 앞 물결이 끝난 뒤 2시간이 지나야 태어난다.
     *      끝남 = 쓰러졌거나(defeatedAt) 태어나고 3시간이 지나 도망갔다.
     *   3. 한 번 칠 때마다 내 칸(shards/{0–7}, 표식의 shard)과 내 수가 같은 커밋에서 같은 만큼 오른다.
     *      보통은 1, 필살기는 20까지(rules.ts RAID_FINISHER_MAX). 필살기 아이템은 규칙이 볼 수 없는
     *      내 정원 문서에 있으므로, 규칙은 한 커밋의 크기와 내 몫(60)만 지킨다 — 혼자 잡지는 못한다.
     *      맞은 수를 칸에 나눠 세는 것은 한 문서에 몰리는 쓰기를 흩기 위해서다(분산 카운터).
     *      합계 = 물결 문서의 hits(칸 이전 화면의 몫) + 칸의 합. 쓰러지기 직전 몇 방은 체력을 넘을 수 있다.
     *   4. 한 사람은 1초에 한 번만, 한 물결에 60번까지만 친다 — 혼자 몰아 잡지 못하게.
     *      체력 하한 180 = 60 × 3명이다.
     *   5. 태어나고 3시간이 지나면 칠 수 없다(도망갔다).
     *   6. 쓰러진 시각은 합계가 체력에 닿았을 때 한 번만 찍히고(규칙이 칸을 모두 읽는다),
     *      쓰러진 뒤에는 칠 수 없다.
     *   7. 참여 인원(칸의 fighters)은 내 표식이 처음 생기는 커밋에서만 오른다.
     * 광장이 정말 무성한지는 규칙이 보지 못한다(칸 24개를 다 읽어야 한다). 그 반칙은
     * 거대 잡초가 일찍 나오는 것뿐이라 감당한다.
     */
    /*
     * 시든 잎 확인 (docs/garden-game.md §3.8) — 원문 링크가 열리는지 사람이 본 결과.
     *
     * 운영자 큐다. 숫자 둘(opens·fails)만 모으고 누구나 읽는다. 누가 답했는지는
     * votes/{uid}에 있고 본인만 읽는다.
     *
     * 한 사람은 잎 하나에 한 번 답한다. 숫자는 그 답이 이 커밋에서 처음 생길 때만,
     * 그 답 쪽으로만 한 칸 오른다. url은 적지 않는다 — 규칙이 id와 url의 짝을 볼 수
     * 없어서, 적게 두면 아무 url이나 적힌다.
     */
    match /leafChecks/{leafId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && leafId.matches('^l[0-9a-z]{1,8}$')
        && request.resource.data.keys().hasOnly(['opens', 'fails', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/leafChecks/$(leafId)/votes/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/leafChecks/$(leafId)/votes/$(request.auth.uid))
        && leafDelta(getAfter(/databases/$(database)/documents/leafChecks/$(leafId)/votes/$(request.auth.uid)).data.verdict);

      allow delete: if false;

      match /votes/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['verdict', 'at'])
          && request.resource.data.verdict in ['opens', 'fails']
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    function leafDelta(verdict) {
      let opens = resource == null ? 0 : resource.data.opens;
      let fails = resource == null ? 0 : resource.data.fails;
      return verdict == 'opens'
        ? request.resource.data.opens == opens + 1 && request.resource.data.fails == fails
        : request.resource.data.fails == fails + 1 && request.resource.data.opens == opens;
    }

    /*
     * 공개 정원과 놀러 가기 (docs/garden-game.md §3.10).
     *
     * gardens/{공개id}           주인이 직접 켠 정원의 모습. 누구나 읽는다.
     *                            정원 이름·텃밭·도감 수·칭호 단계만 담는다. 본명은 없다.
     *   └ waters/{방문자 uid}    그 정원에 물을 준 날. 주인과 그 방문자만 읽는다.
     *
     * 공개 id는 uid가 아니다 — 링크가 돌아도 계정을 되짚지 못하게. ownerUid는 규칙이
     * "주인인가"를 보려고 남긴다(blooms와 같다).
     *
     * 규칙이 지키는 것.
     *   1. 정원 문서는 주인만 쓰고 지운다. 주인은 바뀌지 않는다. 운영자는 지울 수 있다.
     *   2. 물은 남의 정원에만, 한 사람이 한 정원에 하루(한국 날짜) 한 번.
     * 텃밭 목록 안의 값은 규칙이 하나하나 보지 못한다. 화면은 품종표에 있는 id만 그린다.
     */
    match /gardens/{gid} {
      allow read: if true;

      allow create: if request.auth != null
        && gid.matches('^g[0-9a-z]{8,12}$')
        && request.resource.data.ownerUid == request.auth.uid
        && publicGarden();

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && publicGarden();

      allow delete: if (request.auth != null && resource.data.ownerUid == request.auth.uid) || isAdmin();

      match /waters/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid
            || get(/databases/$(database)/documents/gardens/$(gid)).data.ownerUid == request.auth.uid);
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['day', 'at', 'nick'])
          && request.resource.data.day == kstDayNumber()
          && request.resource.data.at == request.time
          && request.resource.data.nick is string
          && request.resource.data.nick.size() >= 1
          && request.resource.data.nick.size() <= 12
          && (resource == null || resource.data.day < kstDayNumber())
          && exists(/databases/$(database)/documents/gardens/$(gid))
          && get(/databases/$(database)/documents/gardens/$(gid)).data.ownerUid != request.auth.uid;
        allow delete: if false;
      }
    }

    /*
     * 초대 씨앗 (docs/garden-game.md §3.10, src/features/garden/rules.ts의 INVITE_*).
     *
     * inviteCodes/{코드}   초대한 사람(uid)과 첫 열매를 거둔 친구 수(joined). 주인만 읽는다.
     * invites/{uid}        나를 초대한 코드(by)와 때(at). 평생 하나. 본인만 읽는다.
     *
     * 규칙이 지키는 것.
     *   1. 코드는 내 uid로, joined 0에서 태어난다.
     *   2. joined는 새 invites 문서 하나와 같은 커밋에서만 1 오른다 — 한 사람은 평생 한 번만 센다.
     *   3. 자기 코드로는 올릴 수 없다.
     * 익명 계정을 여럿 만들어 자기를 초대할 수는 있다. 상자는 초대한 사람마다 평생 10개까지라
     * (정원 장부가 센다) 그 반칙의 끝이 정해져 있다.
     */
    match /inviteCodes/{code} {
      // 없는 문서를 읽는 것(등록 전 확인)은 허락한다. 있는 문서는 주인만.
      allow read: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && code.matches('^i[0-9a-z]{10}$')
        && request.resource.data.keys().hasOnly(['uid', 'joined'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.joined == 0;
      allow update: if request.auth != null
        && resource.data.uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined'])
        && request.resource.data.joined == resource.data.joined + 1
        && !exists(/databases/$(database)/documents/invites/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/invites/$(request.auth.uid)).data.by == code;
      allow delete: if false;
    }

    match /invites/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['by', 'at'])
        && request.resource.data.by is string
        && request.resource.data.by.matches('^i[0-9a-z]{10}$')
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.by)).data.joined
          == get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.by)).data.joined + 1;
      allow update, delete: if false;
    }

    function publicGarden() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ownerUid', 'nick', 'beds', 'dex', 'golden', 'rainbow', 'titles', 'updatedAt'])
        && d.nick is string
        && d.nick.size() >= 1
        && d.nick.size() <= 12
        && d.beds is list
        && d.beds.size() <= 12
        && d.dex is int && d.dex >= 0 && d.dex <= 5000
        && d.golden is int && d.golden >= 0 && d.golden <= 5000
        && d.rainbow is int && d.rainbow >= 0 && d.rainbow <= 5000
        && (!('titles' in d) || publicTitles(d.titles))
        && d.updatedAt == request.time;
    }

    // 칭호 단계(0~3)만. 이름은 화면이 정해 둔 표에서 읽는다 — 사람이 지은 글이 아니다.
    function publicTitles(t) {
      return t is map
        && t.keys().hasOnly(['dex', 'storm', 'plaza'])
        && t.get('dex', 0) is int && t.get('dex', 0) >= 0 && t.get('dex', 0) <= 3
        && t.get('storm', 0) is int && t.get('storm', 0) >= 0 && t.get('storm', 0) <= 3
        && t.get('plaza', 0) is int && t.get('plaza', 0) >= 0 && t.get('plaza', 0) <= 3;
    }

    match /plazaRaids/{raidId} {
      allow read: if true;

      allow create: if request.auth != null
        && raidId.matches('^[0-9]{5}-[1-3]$')
        && raidDay(raidId) == kstDayNumber()
        && request.resource.data.keys().hasOnly(['hp', 'hits', 'fighters', 'spawnedAt', 'defeatedAt'])
        && request.resource.data.hp is int
        && request.resource.data.hp >= 180
        && request.resource.data.hp <= 3000
        && request.resource.data.hits == 0
        && request.resource.data.fighters == 0
        && request.resource.data.spawnedAt == request.time
        && request.resource.data.defeatedAt == null
        && (raidWave(raidId) == 1 || raidPrevDone(raidId));

      // 쓰러뜨리기: 합계(옛 몫 hits + 칸 8개)가 체력에 닿았을 때 쓰러진 시각만 한 번 찍는다.
      allow update: if request.auth != null
        && resource.data.defeatedAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['defeatedAt'])
        && request.resource.data.defeatedAt == request.time
        && resource.data.hits + raidShardHits(raidId) >= resource.data.hp;

      // 옛 화면의 한 방(물결 문서를 직접 1씩 올림). 칸으로 세기 전에 연 탭이 막혀 끝없이 다시
      // 보내지 않게 남겨 둔다. 그 탭들이 사라지면 지운다.
      allow update: if request.auth != null
        && resource.data.defeatedAt == null
        && request.time < resource.data.spawnedAt + duration.value(3, 'h')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hits', 'fighters', 'defeatedAt'])
        && request.resource.data.hits == resource.data.hits + 1
        && request.resource.data.hits <= resource.data.hp
        && request.resource.data.defeatedAt == (request.resource.data.hits == resource.data.hp ? request.time : null)
        && !('shard' in getAfter(raidFighter(raidId)).data)
        && getAfter(raidFighter(raidId)).data.lastAt == request.time
        && request.resource.data.fighters == resource.data.fighters + (exists(raidFighter(raidId)) ? 0 : 1);

      allow delete: if false;

      // 맞은 수를 나눠 세는 칸. 한 방은 내 표식과 내 칸(표식의 shard)을 같은 커밋에서 1씩 올린다.
      match /shards/{n} {
        allow read: if true;
        allow create: if request.auth != null
          && n.matches('^[0-7]$')
          && request.resource.data.keys().hasOnly(['hits', 'fighters'])
          && getAfter(/databases/$(database)/documents/plazaRaids/$(raidId)).data.defeatedAt == null
          && ((request.resource.data.hits == 0 && request.resource.data.fighters == 0)
            || (request.resource.data.hits is int
              && request.resource.data.hits >= 1
              && request.resource.data.hits <= 20
              && request.resource.data.fighters == (exists(raidFighter(raidId)) ? 0 : 1)
              && raidShardPaired(raidId, n)));
        // 얼마나 오르는지는 표식 규칙이 맞춘다(표식이 오른 만큼 칸도 올라야 한다). 여기서는 상한만.
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hits', 'fighters'])
          && request.resource.data.hits is int
          && request.resource.data.hits > resource.data.hits
          && request.resource.data.hits <= resource.data.hits + 20
          && request.resource.data.fighters == resource.data.fighters + (exists(raidFighter(raidId)) ? 0 : 1)
          && raidShardPaired(raidId, n);
        allow delete: if false;
      }

      match /fighters/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['hits', 'lastAt', 'shard'])
          && request.resource.data.lastAt == request.time
          && request.resource.data.hits is int
          && request.resource.data.hits > (resource == null ? 0 : resource.data.hits)
          && request.resource.data.hits <= (resource == null ? 0 : resource.data.hits) + 20
          && request.resource.data.hits <= 60
          && (resource == null || request.time > resource.data.lastAt + duration.value(1, 's'))
          && get(/databases/$(database)/documents/plazaRaids/$(raidId)).data.defeatedAt == null
          && request.time < get(/databases/$(database)/documents/plazaRaids/$(raidId)).data.spawnedAt + duration.value(3, 'h')
          && ('shard' in request.resource.data
            // 지금: 내 칸이 내 수가 오른 만큼 오르고 물결 문서는 그대로다.
            ? request.resource.data.shard is int
              && request.resource.data.shard >= 0
              && request.resource.data.shard <= 7
              && getAfter(raidShardPath(raidId, string(request.resource.data.shard))).data.hits
                == (exists(raidShardPath(raidId, string(request.resource.data.shard)))
                  ? get(raidShardPath(raidId, string(request.resource.data.shard))).data.hits
                  : 0) + (request.resource.data.hits - (resource == null ? 0 : resource.data.hits))
              && getAfter(/databases/$(database)/documents/plazaRaids/$(raidId)).data.hits
                == get(/databases/$(database)/documents/plazaRaids/$(raidId)).data.hits
            // 옛 화면: 한 방씩만, 물결 문서의 합계가 1 오른다.
            : request.resource.data.hits == (resource == null ? 0 : resource.data.hits) + 1
              && getAfter(/databases/$(database)/documents/plazaRaids/$(raidId)).data.hits
              == get(/databases/$(database)/documents/plazaRaids/$(raidId)).data.hits + 1);
        allow delete: if false;
      }
    }

    function raidShardPath(raidId, n) {
      return /databases/$(database)/documents/plazaRaids/$(raidId)/shards/$(n);
    }

    // 이 칸을 올리는 커밋에 내 표식도 함께 올랐고, 그 표식이 이 칸을 가리킨다.
    function raidShardPaired(raidId, n) {
      let mine = getAfter(raidFighter(raidId)).data;
      return mine.lastAt == request.time && 'shard' in mine && string(mine.shard) == n;
    }

    // 칸 8개의 합. 칸이 하나라도 없으면 읽기가 실패해 거절된다 — 쓰러뜨리는 커밋이 빈 칸을 함께 만든다.
    function raidShardHits(raidId) {
      return getAfter(raidShardPath(raidId, '0')).data.hits
        + getAfter(raidShardPath(raidId, '1')).data.hits
        + getAfter(raidShardPath(raidId, '2')).data.hits
        + getAfter(raidShardPath(raidId, '3')).data.hits
        + getAfter(raidShardPath(raidId, '4')).data.hits
        + getAfter(raidShardPath(raidId, '5')).data.hits
        + getAfter(raidShardPath(raidId, '6')).data.hits
        + getAfter(raidShardPath(raidId, '7')).data.hits;
    }

    function raidFighter(raidId) {
      return /databases/$(database)/documents/plazaRaids/$(raidId)/fighters/$(request.auth.uid);
    }

    function raidDay(raidId) {
      return int(raidId.split('-')[0]);
    }

    function raidWave(raidId) {
      return int(raidId.split('-')[1]);
    }

    // 앞 물결이 끝나고 2시간이 지났다. 끝남 = 쓰러졌거나, 태어나고 3시간이 지나 도망갔다.
    function raidPrevDone(raidId) {
      let prev = get(/databases/$(database)/documents/plazaRaids/$(raidId.split('-')[0] + '-' + string(raidWave(raidId) - 1))).data;
      return prev.defeatedAt != null
        ? request.time > prev.defeatedAt + duration.value(2, 'h')
        : request.time > prev.spawnedAt + duration.value(5, 'h');
    }

    match /plazaDays/{day} {
      allow read: if true;
      allow create, update: if request.auth != null
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['pulls', 'gardeners', 'lastCell'])
        && request.resource.data.lastCell is string
        && request.resource.data.lastCell.matches('^c[0-9]{2}$')
        && request.resource.data.pulls == (resource == null ? 0 : resource.data.pulls) + 1
        && getAfter(/databases/$(database)/documents/plazaCells/$(request.resource.data.lastCell)).data.pulledAt == request.time
        && (
          request.resource.data.gardeners == (resource == null ? 0 : resource.data.gardeners)
          || (
            request.resource.data.gardeners == (resource == null ? 0 : resource.data.gardeners) + 1
            && !exists(/databases/$(database)/documents/plazaDays/$(day)/gardeners/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/plazaDays/$(day)/gardeners/$(request.auth.uid))
          )
        );
      allow delete: if false;

      match /gardeners/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }


    /*
     * 피드백 — 이 저장소에서 **공개로 읽는 유일한 것**이다.
     *
     * 공개인 것이 기능이다. 남들이 무엇을 남겼는지 보이지 않으면 같은 말이
     * 계속 쌓인다. 그래서 목록은 누구나 읽고, 같은 생각이면 새로 쓰는 대신
     * '나도요'를 누르게 한다.
     *
     * 익명이다. authorUid는 본인 삭제와 중복 '나도요'를 막는 데만 쓰고 화면에
     * 내보내지 않는다. 다만 **규칙이 익명성을 보장하지는 않는다** — 문서를
     * 직접 읽으면 uid가 보인다. 화면에 이름이 안 뜬다는 뜻이지 uid가 비밀이라는
     * 뜻이 아니며, 그래서 uid로 사람을 되짚을 수 있는 것을 넣지 않는다.
     */
    match /feedback/{id} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000
        && request.resource.data.kind in ['bug', 'idea', 'content', 'etc']
        // 새 글은 늘 같은 자리에서 시작한다. 상태와 답변은 운영자만 만진다.
        && request.resource.data.status == 'open'
        && request.resource.data.agreeCount == 0
        && request.resource.data.reply == null;

      // 제 글은 지울 수 있다. 운영자는 무엇이든 지운다.
      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());

      allow update: if isAdmin()
        ? request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reply', 'repliedAt'])
          && request.resource.data.status in ['open', 'planned', 'done', 'wontfix']
        : isAgreeDelta(
            /databases/$(database)/documents/feedback/$(id)/agrees/$(request.auth.uid)
          );

      /*
       * 나도요. 한 사람이 한 번만 누르도록 uid를 문서 id로 쓴다.
       * 카운터는 부모 문서에 있고, 위 isAgreeDelta가 이 문서와 짝이 맞는지 본다.
       */
      match /agrees/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    /*
     * 정정·반론 접수 (검토 문서 3장).
     *
     * ★ 피드백과 반대로, 여기는 공개가 아닌 것이 기능이다.
     *   실린 내용이 틀렸다는 주장은 대개 남에 대한 이야기를 담는다. 공개
     *   게시판에 두면 그 글 자체를 이 사이트가 싣게 되고, 접수함이 아니라
     *   또 하나의 발행면이 된다. 그래서 본인과 운영자만 읽는다.
     *
     * 지우는 것은 본인과 운영자 둘 다 할 수 있다. 접수 기록을 남기는 편이
     * 방어에는 낫지만, 제가 쓴 글을 거둘 수 없게 만들면서 연락처까지 받는
     * 창구는 만들지 않는다.
     */
    match /corrections/{id} {
      allow read: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 2000
        && request.resource.data.kind in ['fact', 'rebuttal', 'takedown']
        && request.resource.data.role in ['subject', 'related', 'reader']
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 300
        && request.resource.data.evidenceUrl is string
        && request.resource.data.evidenceUrl.size() <= 500
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 200
        // 새 접수는 늘 같은 자리에서 시작한다. 상태를 옮기는 것은 운영자다.
        && request.resource.data.status == 'received';

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'note', 'handledAt'])
        && request.resource.data.status in ['received', 'checking', 'fixed', 'declined'];

      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    /*
     * 지지자 응원 — 영상.
     *
     * ★ 문서 id가 곧 유튜브 영상 id다.
     *   같은 영상이 두 번 올라오는 것을 규칙이나 화면이 아니라 **저장소가**
     *   막는다. 필드로 두면 목록을 다 읽어 봐야 알 수 있고, 두 사람이 같은
     *   순간에 올리면 둘 다 통과한다.
     *
     * ★ 제목과 채널은 규칙이 보증하지 못한다.
     *   화면은 /api/youtube가 준 것을 그대로 올리지만, 규칙이 볼 수 있는 것은
     *   길이뿐이다. 거짓 제목을 붙인 문서를 손으로 만들 수는 있다는 뜻이다.
     *   그래서 운영자가 내릴 수 있게 해 두었고, 그게 여기서 감당하는 방식이다.
     */
    /*
     * 응원이 가리키는 언행(topic) — 없어도 되고, 있으면 언행 slug 모양이어야 한다.
     * 실제로 있는 언행인지는 규칙이 모른다. 화면은 아는 slug만 붙이고, 모르는 이름표는
     * 그리지 않는다. 이름표일 뿐이라 원문 화면에는 아무것도 실리지 않는다.
     */
    function cheerTopicOk(data) {
      return !('topic' in data)
        || (data.topic is string && data.topic.matches('^[a-z0-9-]{1,80}$'));
    }

    match /cheerVideos/{youtubeId} {
      allow read: if true;

      allow create: if request.auth != null
        && youtubeId.matches('^[A-Za-z0-9_-]{11}$')
        && request.resource.data.youtubeId == youtubeId
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.channel is string
        && request.resource.data.channel.size() > 0
        && request.resource.data.channel.size() <= 100
        && cheerTopicOk(request.resource.data);

      // 올린 사람은 제 것을 거둘 수 있고, 운영자는 무엇이든 내린다.
      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());

      /*
       * 한 번 걸린 영상은 고쳐지지 않는다. 내리고 다시 올린다.
       * 이 한 줄이 겹침 방지이기도 하다 — setDoc이 덮어쓰려 들면 여기서 막힌다.
       */
      allow update: if false;
    }

    /*
     * 지지자 응원 — 한 줄.
     *
     * ★ 80자다. 이 숫자가 설계 전부다.
     *   한 줄로는 남을 헐뜯거나 논쟁을 벌일 수 없고, 운영자가 한 건 읽는 데
     *   2초면 된다. 길이를 늘리는 순간 이것은 응원판이 아니라 정치 게시판이
     *   되고, 그때부터 옆 탭에 있는 근거까지 같이 의심받는다.
     *
     * ★ 답글이 없다. 오가는 말이 생기면 그것도 게시판이다.
     *   그래서 여기 update로 열려 있는 것은 '나도요' 카운터뿐이다 — 운영자도
     *   남의 글을 고치지 못하고, 지울 수만 있다.
     */
    match /cheerNotes/{id} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 80
        && request.resource.data.agreeCount == 0
        && cheerTopicOk(request.resource.data);

      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());

      allow update: if isAgreeDelta(
        /databases/$(database)/documents/cheerNotes/$(id)/agrees/$(request.auth.uid)
      );

      match /agrees/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    /*
     * 업적 인포그래픽 — 구글 계정을 연결한 사람이 올리고, 운영자가 승인한 것만 싣는다.
     *
     * ★ 새 그림은 늘 승인 대기로 시작한다.
     *   업적 페이지는 근거가 붙은 것만 싣는 자리다. 올리자마자 보이면 확인하지
     *   않은 숫자가 업적과 같은 층에 선다. status를 옮기는 것은 운영자뿐이다.
     *
     * ★ 승인 대기인 것은 올린 사람과 운영자만 읽는다.
     *   목록 조회가 이 규칙을 통과하려면 쿼리가 status나 authorUid로 걸러야
     *   한다. 화면은 셋 중 하나로만 묻는다 — 실린 것, 내 것, 대기열(운영자).
     *
     * ★ 올리는 것은 구글 계정을 연결한 사람뿐이다(hasGoogle).
     *
     * ★ 그림 경로는 올린 사람과 문서 id로 정해진다.
     *   Storage 규칙이 경로의 uid로 주인을 가리므로, 문서가 남의 경로를
     *   가리키지 못하게 여기서 맞춘다.
     */
    /*
     * 구글 계정을 연결했는가. 익명 계정에서 연결한 경우에도 identities에
     * google.com이 들어간다. 익명 계정은 브라우저를 지우면 사라지는
     * 일회용이라, 내려야 할 그림을 올린 사람을 되짚을 수 없다.
     */
    function hasGoogle() {
      return request.auth != null
        && 'google.com' in request.auth.token.firebase.identities;
    }

    match /infographics/{id} {
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && resource.data.authorUid == request.auth.uid)
        || isAdmin();

      allow create: if hasGoogle()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        // 그림만 있으면 된다. 제목과 설명은 비워 둘 수 있다.
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.alt is string
        && request.resource.data.alt.size() <= 3000
        // 등록자 이름은 고를 수 있다. 적었다면 30자까지.
        && (request.resource.data.get('authorName', null) == null
          || (request.resource.data.authorName is string
            && request.resource.data.authorName.size() > 0
            && request.resource.data.authorName.size() <= 30))
        && request.resource.data.imagePath == 'infographics/' + request.auth.uid + '/' + id
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2000
        && request.resource.data.width is int
        && request.resource.data.width > 0
        && request.resource.data.height is int
        && request.resource.data.height > 0;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'approvedAt'])
        && request.resource.data.status in ['pending', 'approved'];

      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    /*
     * 운영자 명단. 콘솔에서 손으로 넣는다.
     *
     * 자기 문서만 읽게 해서 "내가 운영자인가"만 확인할 수 있고 명단 전체는
     * 볼 수 없다. 쓰기는 아무에게도 열지 않는다 — 콘솔로만 바꾼다.
     */
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // 그 밖의 모든 것은 닫는다. 열어야 할 것이 생기면 그때 이름을 적는다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
