rules_version = '2';

/*
 * 잼통 Firestore 규칙.
 *
 * 기본 규칙은 하나다: 자기 것만 읽고 쓴다.
 *
 * 이력이 users/{uid} 아래 있는 이유가 이것이다. 최상위에 두고 필드로 주인을
 * 가리면 목록 조회마다 그 필드를 검사해야 하고, 검사를 한 군데 빠뜨리면 남의
 * 기록이 열린다. 경로로 가르면 빠뜨릴 자리가 없다.
 *
 * 익명 계정도 uid를 가지므로 같은 규칙이 그대로 적용된다.
 *
 * ★ 예외가 여럿 있다: feedback, cheerVideos, cheerNotes, infographics, 정원의 공유 상태(plaza*·blooms·leafChecks).
 *   앞의 셋과 정원의 공유 상태는 누구나 읽고, 인포그래픽은 승인된 것만 누구나 읽는다.
 *   공개인 것이 기능이기 때문이다 — 남이 무엇을 남겼는지 보이지 않으면
 *   같은 말이 계속 쌓이고, 응원판은 아예 성립하지 않는다. 그래서 여기만
 *   경로로 가르지 못하고 필드와 모양을 일일이 검사한다. 예외를 하나 두면
 *   검사가 얼마나 늘어나는지를 이 파일이 그대로 보여 준다.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /**
     * '나도요'로 인한 카운터 변화인가.
     *
     * agreeCount 한 칸만 움직여야 하고, 그 방향이 이 커밋에서 agrees 문서가
     * 생겼는지 지워졌는지와 맞아야 한다. 짝을 맞추지 않으면 카운터만 올리는
     * 요청이 통과한다.
     *
     * 표시 문서의 경로를 인자로 받는다. 피드백과 응원이 같은 모양을 쓰므로,
     * 컬렉션 이름을 안에 박아 두면 두 벌이 생기고 둘 중 하나는 반드시 덜
     * 검사된다. 이 불변식은 한 군데에만 있어야 한다.
     */
    function isAgreeDelta(agreePath) {
      let before = resource.data.agreeCount;
      let after = request.resource.data.agreeCount;
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agreeCount'])
        && (
          (after == before + 1 && !exists(agreePath) && existsAfter(agreePath))
          || (after == before - 1 && exists(agreePath) && !existsAfter(agreePath))
        );
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /asks/{askId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;

        // 만들 때만 모양을 본다. 이력은 고치는 것이 아니라 쌓고 지우는 것이다.
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.question is string
          && request.resource.data.question.size() <= 500
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 4000
          && request.resource.data.achievementSlug is string
          && request.resource.data.grounded is bool;

        allow update: if false;
      }

      /*
       * 개인 정원 (docs/garden-game.md). 한 문서에 다 담는다.
       * 잼은 이 정원 안에서만 쓰이고 거래도 없으므로 값의 정직성은 보지 않는다.
       * 모양과 크기만 본다 — 문서가 끝없이 커지지 않게.
       */
      match /garden/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && docId == 'state'
          && request.resource.data.jam is number
          && request.resource.data.beds is list
          && request.resource.data.beds.size() <= 12
          && request.resource.data.basket is list
          && request.resource.data.basket.size() <= 120
          && request.resource.data.notes is list
          && request.resource.data.notes.size() <= 2000;
      }
    }

    /*
     * 광장 — 모두가 함께 쓰는 정원 (docs/garden-game.md §3.8).
     *
     * ★ 누구나 읽는다. 잡초가 모두에게 보여야 함께 치울 수 있다.
     *
     * ★ 칸에는 누가 뽑았는지 남기지 않는다.
     *
     * 규칙이 지키는 불변식은 셋이다.
     *   1. 없는 잡초는 뽑지 못한다 — 직전 regrowAt이 지났어야 한다.
     *   2. 다시 나는 시각은 [15, 245]분 뒤다. 화면은 [20, 240]분을 고르고,
     *      양쪽 5분은 기기 시계가 어긋난 몫이다.
     *   3. 기록판은 같은 커밋에서 실제로 뽑힌 칸과 짝이 맞을 때만 한 칸 오른다.
     *      정원지기 수는 표식 문서가 이 커밋에서 처음 생길 때만 오른다.
     */
    match /plazaCells/{cell} {
      allow read: if true;
      allow create, update: if request.auth != null
        && cell.matches('^c[0-9]{2}$')
        && int(cell.split('c')[1]) < 24
        && request.resource.data.keys().hasOnly(['gen', 'pulledAt', 'regrowAt'])
        && request.resource.data.pulledAt == request.time
        && request.resource.data.gen == (resource == null ? 1 : resource.data.gen + 1)
        && (resource == null || resource.data.regrowAt <= request.time)
        && request.resource.data.regrowAt >= request.time + duration.value(15, 'm')
        && request.resource.data.regrowAt <= request.time + duration.value(245, 'm');
      allow delete: if false;
    }

    /*
     * 꽃밭 — 업적을 함께 피우고, 가장 많이 가꾼 사람이 정원지기가 된다
     * (docs/garden-game.md §3.9).
     *
     * 정원지기는 경쟁하는 공개 자리라 값을 규칙이 본다.
     *   1. 내 가꿈은 한 번에 1~2, 한 업적에 하루(한국 날짜) 12까지 오른다.
     *   2. 합계는 같은 커밋에서 내 가꿈이 오른 만큼만 오른다.
     *   3. 만개 시각은 합계가 30을 넘는 커밋에서 한 번만 찍히고 다시 바뀌지 않는다.
     *   4. 정원지기는 나로만 바뀌고, 그때 값은 내 가꿈이며, 지금 정원지기보다 많아야 한다.
     *      이미 내가 정원지기면 값만 따라 오른다.
     * 운영자는 정원 이름이 부적절하면 지울 수 있다(ownerNick → null). 지운 이름은
     * hiddenNick에 남고, 그 이름으로는 다시 걸 수 없다 — 다음 가꿈에서 같은 이름이
     * 되살아나지 않게. 정원지기는 이름을 바꾸면 다시 걸 수 있다.
     */
    function kstDayNumber() {
      return math.floor((request.time.toMillis() + 32400000) / 86400000);
    }

    match /blooms/{speciesId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && speciesId.matches('^a:[a-z0-9-]+$')
        && request.resource.data.keys().hasOnly(['care', 'bloomedAt', 'ownerUid', 'ownerNick', 'ownerCare', 'hiddenNick'])
        && request.resource.data.get('hiddenNick', null) == (resource == null ? null : resource.data.get('hiddenNick', null))
        && bloomCareDelta(speciesId)
        && bloomStamp()
        && bloomOwner(speciesId);

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerNick', 'hiddenNick'])
        && resource.data.ownerNick is string
        && request.resource.data.ownerNick == null
        && request.resource.data.hiddenNick == resource.data.ownerNick;

      allow delete: if false;

      match /keepers/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['care', 'day', 'dayCare', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.day == kstDayNumber()
          && keeperDelta() >= 1
          && keeperDelta() <= 2
          && request.resource.data.dayCare
            == (resource != null && resource.data.day == kstDayNumber() ? resource.data.dayCare : 0) + keeperDelta()
          && request.resource.data.dayCare <= 12;
        allow delete: if false;
      }
    }

    function keeperDelta() {
      return request.resource.data.care - (resource == null ? 0 : resource.data.care);
    }

    function keeperPath(speciesId) {
      return /databases/$(database)/documents/blooms/$(speciesId)/keepers/$(request.auth.uid);
    }

    function myCareAfter(speciesId) {
      return getAfter(keeperPath(speciesId)).data.care;
    }

    function myCareBefore(speciesId) {
      return exists(keeperPath(speciesId)) ? get(keeperPath(speciesId)).data.care : 0;
    }

    function bloomCareDelta(speciesId) {
      return request.resource.data.care
        == (resource == null ? 0 : resource.data.care) + (myCareAfter(speciesId) - myCareBefore(speciesId));
    }

    function bloomStamp() {
      let before = resource == null ? null : resource.data.bloomedAt;
      let after = request.resource.data.bloomedAt;
      return before != null
        ? after == before
        : (request.resource.data.care >= 30 ? after == request.time : after == null);
    }

    function bloomOwner(speciesId) {
      let d = request.resource.data;
      let unchanged = resource != null
        && d.ownerUid == resource.data.ownerUid
        && d.ownerNick == resource.data.ownerNick
        && d.ownerCare == resource.data.ownerCare;
      let mine = d.ownerUid == request.auth.uid
        && d.ownerCare == myCareAfter(speciesId)
        && (d.ownerNick == null
          || (d.ownerNick is string
            && d.ownerNick.size() >= 1
            && d.ownerNick.size() <= 12
            && d.ownerNick != d.get('hiddenNick', null)))
        && (resource == null
          || resource.data.ownerUid == request.auth.uid
          || d.ownerCare > resource.data.ownerCare);
      return unchanged || mine;
    }

    /*
     * 거대 잡초 — 광장이 무성해지면 나타나는 레이드 (docs/garden-game.md §3.8, docs/garden-miniroom.md §7).
     *
     * plazaRaids/{한국 날짜 번호}-{물결}   하루 다섯 마리까지. 체력(hp)·태어난 때·쓰러진 때.
     *   ├ shards/{0–7}                    맞은 수(hits)·참여 인원(fighters)을 나눠 센다. 누구나 읽는다.
     *   │                                 함께한 사람 이름(names, 칸마다 30)과 마지막 지원(aid·aidAt·aidBy)도 싣는다.
     *   └ fighters/{uid}                  한 사람의 센 값(hits)·쓴 기력(uses)·지원(aid·aidAt·aids)·칸. 본인만 읽는다.
     *
     * 규칙이 지키는 것. 값은 src/features/garden/rules.ts의 RAID_*와 같다(raid.test.ts가 본다).
     *   1. 오늘 번호로만, 물결 1–5로, 체력 [270, 3000]으로, 맞은 수 0에서 태어난다.
     *      270 = 3명 × 기력 60 × 1.5. 한 사람이 넣을 수 있는 맞은 수는 120(60 × 빈틈 2)이라 혼자도 둘도 못 잡는다.
     *   2. 다음 물결은 제 시각(8·11·14·17·20시)이 됐고 앞 물결이 끝나고 30분이 지나야 태어난다.
     *   3. 한 번 칠 때마다 내 칸과 내 표식이 같은 커밋에서 같은 만큼 오른다. 기력 1(필살기는 20까지)을 쓰고,
     *      빈틈이면 그 두 배를 센다 — 빈틈은 request.time의 분과 물결의 spawnedAt으로만 본다(raidGap).
     *      아이템은 규칙이 볼 수 없는 내 정원 문서에 있으므로, 규칙은 한 커밋의 크기와 기력 60만 지킨다.
     *   4. 한 사람은 1초에 한 번만, 한 물결에 기력 60까지만 쓴다.
     *   5. 지원은 종류 1–3, 앞선 지원에서 20초 뒤. 센 값은 그대로다(효과는 화면의 손맛뿐).
     *   6. 태어나고 3시간이 지나면 칠 수 없다(도망갔다).
     *   7. 쓰러진 시각은 합계(물결 문서 hits + 칸 8)가 체력에 닿았을 때 한 번만 찍힌다. 쓰러진 뒤에는 칠 수 없다.
     *   8. 참여 인원(칸의 fighters)과 이름(names)은 내 표식이 처음 생기는 커밋에서만 하나 는다.
     *
     * 옛 화면(기력 2.0 이전)과 함께 산다. uses 없이 hits만 올리는 표식은 빈틈 없이 한 번 = 1로 받는다
     * (기력 = 센 값). 옛 화면은 칸을 set으로 통째로 쓰므로 names·aid가 지워질 수 있다 — 화면의 연출만 잃는다.
     * 광장이 정말 무성한지는 규칙이 보지 못한다(칸 24개를 다 읽어야 한다). 그 반칙은 거대 잡초가 일찍 나오는 것뿐이다.
     */
    /*
     * 시든 잎 확인 (docs/garden-game.md §3.8) — 원문 링크가 열리는지 사람이 본 결과.
     *
     * 운영자 큐다. 숫자 둘(opens·fails)만 모으고 누구나 읽는다. 누가 답했는지는
     * votes/{uid}에 있고 본인만 읽는다.
     *
     * 한 사람은 잎 하나에 한 번 답한다. 숫자는 그 답이 이 커밋에서 처음 생길 때만,
     * 그 답 쪽으로만 한 칸 오른다. url은 적지 않는다 — 규칙이 id와 url의 짝을 볼 수
     * 없어서, 적게 두면 아무 url이나 적힌다.
     */
    match /leafChecks/{leafId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && leafId.matches('^l[0-9a-z]{1,8}$')
        && request.resource.data.keys().hasOnly(['opens', 'fails', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/leafChecks/$(leafId)/votes/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/leafChecks/$(leafId)/votes/$(request.auth.uid))
        && leafDelta(getAfter(/databases/$(database)/documents/leafChecks/$(leafId)/votes/$(request.auth.uid)).data.verdict);

      allow delete: if false;

      match /votes/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['verdict', 'at'])
          && request.resource.data.verdict in ['opens', 'fails']
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    function leafDelta(verdict) {
      let opens = resource == null ? 0 : resource.data.opens;
      let fails = resource == null ? 0 : resource.data.fails;
      return verdict == 'opens'
        ? request.resource.data.opens == opens + 1 && request.resource.data.fails == fails
        : request.resource.data.fails == fails + 1 && request.resource.data.opens == opens;
    }

    /*
     * 공개 정원과 놀러 가기 (docs/garden-game.md §3.10), 1촌·방명록·손님 수 (docs/garden-miniroom.md §5.5).
     *
     * gardens/{공개id}            주인이 직접 켠 정원의 모습. 누구나 읽는다.
     *                             정원 이름·텃밭·도감 수·칭호 단계·방·소식(종류 번호)만 담는다. 본명은 없다.
     *                             1촌이 있는 방은 공개를 꺼도 지우지 않고 가린다(hidden) — 그때는 주인과 hidden만 남긴다.
     *   ├ waters/{방문자 uid}     그 정원에 물을 준 날. 주인과 그 방문자만 읽는다.
     *   ├ knocks/{신청자 uid}     1촌 신청. 주인과 신청자만 읽고 지운다.
     *   ├ ilchon/{1촌 uid}        1촌. 주인과 그 1촌만 읽는다. 양쪽이 한 커밋에서 생기고 함께 지워진다.
     *   ├ blocks/{uid}            차단. 주인만.
     *   ├ guestbook/{uid}_{날}    방명록. 방을 가리지 않았으면 누구나 읽는다.
     *   ├ notes/{1촌 uid}         1촌평. 방을 가리지 않았으면 누구나 읽는다.
     *   ├ visits/{손님 uid}       손님이 온 날. 주인과 그 손님만 읽는다.
     *   └ meta/counter            오늘 손님·모든 손님.
     *
     * 공개 id는 uid가 아니다 — 링크가 돌아도 계정을 되짚지 못하게. ownerUid는 규칙이
     * "주인인가"를 보려고 남긴다(blooms와 같다). 하위 문서의 주인은 언제나 get(gardens/{gid}).ownerUid로 본다.
     *
     * 규칙이 지키는 것. 값은 src/features/garden/ilchon/rules.ts와 같다(ilchon/rules.test.ts가 본다).
     *   1. 정원 문서는 주인만 쓰고 지운다. 주인은 바뀌지 않는다. 운영자는 지울 수 있다.
     *   2. 물은 남의 (가리지 않은) 정원에만, 한 사람이 한 정원에 하루(한국 날짜) 한 번.
     *      1촌의 물(il)은 정말 1촌일 때만 적힌다 — 받는 쪽은 이 표시를 믿고 더 줄인다.
     *   3. 신청: 신청자가 그 공개 id의 주인이고 그 방이 열려 있다. 남의 열린 방에만, 받기를 켰을 때만,
     *      차단되지 않았고 아직 1촌이 아닐 때만.
     *   4. 1촌: 수락하는 사람이 양쪽 1촌 문서를 한 커밋으로 쓰고 신청을 지운다. 신청이 있었을 때만,
     *      신청의 공개 id·이름표와 맞을 때만. 지울 때도 양쪽이 함께(상대 방이 없어졌으면 내 쪽만).
     *   5. 방명록: 남의 열린 방에만, 하루 한 번(문서 id = uid_오늘), 주인이 받기를 고른 대로, 차단되지 않았을 때.
     *      1촌평: 1촌만, 한 사람 한 줄. 둘 다 문구 번호·스티커 번호가 표 안에 있고 직접 쓴 글은 60자까지.
     *      운영자는 hidden만 바꾼다(가리기). 주인·쓴 사람·운영자가 지운다.
     *   6. 손님 수: 표식(visits)이 오늘 처음 생기는 커밋에서만 1 오른다. 내 방은 세지 않는다.
     * 1촌 50명·보낸 신청 10건의 상한은 세지 못한다(문서를 셀 길이 없다). 화면이 지킨다.
     * 텃밭·방·소식 목록 안의 값은 규칙이 하나하나 보지 못한다. 화면은 표에 있는 id만 그린다.
     */
    match /gardens/{gid} {
      allow read: if true;

      allow create: if request.auth != null
        && gid.matches('^g[0-9a-z]{8,12}$')
        && request.resource.data.ownerUid == request.auth.uid
        && (publicGarden() || hiddenGarden());

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (publicGarden() || hiddenGarden());

      allow delete: if (request.auth != null && resource.data.ownerUid == request.auth.uid) || isAdmin();

      match /waters/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid || isGardenOwner(gid));
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['day', 'at', 'nick', 'il'])
          && request.resource.data.day == kstDayNumber()
          && request.resource.data.at == request.time
          && nickOk(request.resource.data.nick)
          && (resource == null || resource.data.day < kstDayNumber())
          && roomOpenToMe(gid)
          && (!('il' in request.resource.data)
            || (request.resource.data.il == true && exists(ilchonPath(gid, request.auth.uid))));
        allow delete: if false;
      }

      match /knocks/{uid} {
        allow read, delete: if request.auth != null
          && (request.auth.uid == uid || isGardenOwner(gid));
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['g', 'n', 'tag', 'at'])
          && request.resource.data.at == request.time
          && nickOk(request.resource.data.n)
          && tagOk(request.resource.data.tag)
          && request.resource.data.g is string
          && request.resource.data.g.matches('^g[0-9a-z]{8,12}$')
          && request.resource.data.g != gid
          && myOpenRoom(request.resource.data.g)
          && roomOpenToMe(gid)
          && get(gardenPath(gid)).data.get('accept', true) == true
          && !exists(blockPath(gid, request.auth.uid))
          && !exists(ilchonPath(gid, request.auth.uid));
        allow update: if false;
      }

      match /ilchon/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid || isGardenOwner(gid));
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['g', 'n', 'tag', 'at'])
          && request.resource.data.at == request.time
          && nickOk(request.resource.data.n)
          && tagOk(request.resource.data.tag)
          && request.resource.data.g is string
          && request.resource.data.g.matches('^g[0-9a-z]{8,12}$')
          && request.resource.data.g != gid
          && (ilchonMine(gid, uid) || ilchonTheirs(gid, uid));
        // 내 쪽 이름표만 바꾼다.
        allow update: if isGardenOwner(gid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tag'])
          && tagOk(request.resource.data.tag);
        // 끊기: 주인이나 그 1촌이, 상대 쪽 문서도 같은 커밋에서 지울 때만. 상대 방이 없어졌으면 이쪽만.
        allow delete: if request.auth != null
          && (
            (request.auth.uid == uid && !exists(gardenPath(gid)))
            || ((request.auth.uid == uid || isGardenOwner(gid))
              && (!exists(gardenPath(resource.data.g))
                || !existsAfter(ilchonPath(resource.data.g, gardenOwner(gid)))))
          );
      }

      match /blocks/{uid} {
        allow read, delete: if isGardenOwner(gid);
        allow create, update: if isGardenOwner(gid)
          && uid != request.auth.uid
          && request.resource.data.keys().hasOnly(['n', 'at'])
          && nickOk(request.resource.data.n)
          && request.resource.data.at == request.time;
      }

      match /guestbook/{eid} {
        allow read: if roomVisible(gid) || isGardenOwner(gid) || isAdmin();
        allow create: if request.auth != null
          && eid == request.auth.uid + '_' + string(int(kstDayNumber()))
          && request.resource.data.keys().hasOnly(['g', 'n', 'p', 'x', 'k', 'at'])
          && request.resource.data.at == request.time
          && nickOk(request.resource.data.n)
          && lineOk(request.resource.data)
          && authorRoomOk(request.resource.data.g)
          && roomOpenToMe(gid)
          && guestbookOpen(gid)
          && !exists(blockPath(gid, request.auth.uid));
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
          && request.resource.data.hidden is bool;
        allow delete: if request.auth != null
          && (eid.split('_')[0] == request.auth.uid || isGardenOwner(gid) || isAdmin());
      }

      match /notes/{uid} {
        allow read: if roomVisible(gid) || isGardenOwner(gid) || isAdmin();
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['g', 'n', 'tag', 'p', 'x', 'k', 'at'])
          && request.resource.data.at == request.time
          && nickOk(request.resource.data.n)
          && tagOk(request.resource.data.tag)
          && lineOk(request.resource.data)
          && (resource == null || resource.data.get('hidden', false) != true)
          && request.resource.data.g == get(ilchonPath(gid, uid)).data.g;
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden'])
          && request.resource.data.hidden is bool;
        allow delete: if request.auth != null
          && (request.auth.uid == uid || isGardenOwner(gid) || isAdmin());
      }

      match /visits/{uid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid || isGardenOwner(gid));
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['day'])
          && request.resource.data.day == kstDayNumber()
          && (resource == null || resource.data.day < kstDayNumber())
          && roomOpenToMe(gid)
          && getAfter(counterPath(gid)).data.total
            == (exists(counterPath(gid)) ? get(counterPath(gid)).data.total : 0) + 1;
        allow delete: if false;
      }

      match /meta/{docId} {
        allow read: if docId == 'counter' && (roomVisible(gid) || isGardenOwner(gid));
        allow create, update: if request.auth != null
          && docId == 'counter'
          && request.resource.data.keys().hasOnly(['day', 'today', 'total'])
          && request.resource.data.day == kstDayNumber()
          && request.resource.data.total == (resource == null ? 0 : resource.data.total) + 1
          && request.resource.data.today
            == ((resource != null && resource.data.day == kstDayNumber()) ? resource.data.today : 0) + 1
          && (!exists(visitPath(gid)) || get(visitPath(gid)).data.day < kstDayNumber())
          && getAfter(visitPath(gid)).data.day == kstDayNumber();
        allow delete: if false;
      }
    }

    function gardenPath(gid) {
      return /databases/$(database)/documents/gardens/$(gid);
    }

    function gardenOwner(gid) {
      return get(gardenPath(gid)).data.ownerUid;
    }

    function isGardenOwner(gid) {
      return request.auth != null && gardenOwner(gid) == request.auth.uid;
    }

    // 가리지 않은 방. 없는 방이면 get이 실패해 거절된다.
    function roomVisible(gid) {
      return get(gardenPath(gid)).data.get('hidden', false) != true;
    }

    // 남이 들어올 수 있는 방: 있고, 가리지 않았고, 내 방이 아니다.
    function roomOpenToMe(gid) {
      return gardenOwner(gid) != request.auth.uid && roomVisible(gid);
    }

    // 내가 주인인 열린 방(신청은 서로 가리킬 공개 id가 있어야 한다).
    function myOpenRoom(g) {
      return gardenOwner(g) == request.auth.uid && roomVisible(g);
    }

    function ilchonPath(gid, uid) {
      return /databases/$(database)/documents/gardens/$(gid)/ilchon/$(uid);
    }

    function knockPath(gid, uid) {
      return /databases/$(database)/documents/gardens/$(gid)/knocks/$(uid);
    }

    function blockPath(gid, uid) {
      return /databases/$(database)/documents/gardens/$(gid)/blocks/$(uid);
    }

    function counterPath(gid) {
      return /databases/$(database)/documents/gardens/$(gid)/meta/counter;
    }

    function visitPath(gid) {
      return /databases/$(database)/documents/gardens/$(gid)/visits/$(request.auth.uid);
    }

    function nickOk(n) {
      return n is string && n.size() >= 1 && n.size() <= 12;
    }

    // 1촌 이름표 번호(ilchon/rules.ts의 TAGS).
    function tagOk(t) {
      return t is int && t >= 0 && t < 8;
    }

    // 한 줄: 정해 둔 문구(p, PHRASES) 또는 직접 쓴 글(x, 60자) 중 하나와 스티커(k, STICKERS).
    function lineOk(d) {
      return d.p is int && d.p >= -1 && d.p < 30
        && d.k is int && d.k >= 0 && d.k < 12
        && d.x is string
        && (d.p == -1 ? (d.x.size() >= 1 && d.x.size() <= 60) : d.x.size() == 0);
    }

    // 방명록에 적는 내 공개 id. 방을 열지 않았으면 ""(이름을 눌러도 갈 곳이 없다). 적었다면 내 것이어야 한다.
    function authorRoomOk(g) {
      return g is string
        && (g == '' || (g.matches('^g[0-9a-z]{8,12}$') && gardenOwner(g) == request.auth.uid));
    }

    function guestbookOpen(gid) {
      let mode = get(gardenPath(gid)).data.get('guestbook', 'all');
      return mode == 'all' || (mode == 'ilchon' && exists(ilchonPath(gid, request.auth.uid)));
    }

    /*
     * 수락하는 주인이 내 쪽(gardens/{gid}/ilchon/{신청자 uid})을 쓴다.
     * 신청이 있었고 이 커밋에서 지워지며, 공개 id가 신청과 같고, 상대 쪽 문서도 이 커밋에서 생긴다.
     */
    function ilchonMine(gid, uid) {
      let d = request.resource.data;
      return uid != request.auth.uid
        && isGardenOwner(gid)
        && exists(knockPath(gid, uid))
        && !existsAfter(knockPath(gid, uid))
        && get(knockPath(gid, uid)).data.g == d.g
        && existsAfter(ilchonPath(d.g, request.auth.uid));
    }

    /*
     * 수락하는 사람이 상대 쪽(gardens/{신청자 공개id}/ilchon/{내 uid})을 쓴다. d.g는 내 공개 id.
     * 상대가 내 방에 보낸 신청이 있었고 이 커밋에서 지워지며, 그 신청이 이 방을 가리키고,
     * 이름표는 상대가 신청할 때 고른 것이고, 내 쪽 문서도 이 커밋에서 생긴다.
     */
    function ilchonTheirs(gid, uid) {
      let d = request.resource.data;
      let them = gardenOwner(gid);
      return uid == request.auth.uid
        && them != request.auth.uid
        && gardenOwner(d.g) == request.auth.uid
        && exists(knockPath(d.g, them))
        && !existsAfter(knockPath(d.g, them))
        && get(knockPath(d.g, them)).data.g == gid
        && get(knockPath(d.g, them)).data.tag == d.tag
        && existsAfter(ilchonPath(d.g, them));
    }

    /*
     * 초대 씨앗 (docs/garden-game.md §3.10, src/features/garden/rules.ts의 INVITE_*).
     *
     * inviteCodes/{코드}   초대한 사람(uid)과 첫 열매를 거둔 친구 수(joined). 주인만 읽는다.
     * invites/{uid}        나를 초대한 코드(by)와 때(at). 평생 하나. 본인만 읽는다.
     *
     * 규칙이 지키는 것.
     *   1. 코드는 내 uid로, joined 0에서 태어난다.
     *   2. joined는 새 invites 문서 하나와 같은 커밋에서만 1 오른다 — 한 사람은 평생 한 번만 센다.
     *   3. 자기 코드로는 올릴 수 없다.
     * 익명 계정을 여럿 만들어 자기를 초대할 수는 있다. 상자는 초대한 사람마다 평생 10개까지라
     * (정원 장부가 센다) 그 반칙의 끝이 정해져 있다.
     */
    match /inviteCodes/{code} {
      // 없는 문서를 읽는 것(등록 전 확인)은 허락한다. 있는 문서는 주인만.
      allow read: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && code.matches('^i[0-9a-z]{10}$')
        && request.resource.data.keys().hasOnly(['uid', 'joined'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.joined == 0;
      allow update: if request.auth != null
        && resource.data.uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined'])
        && request.resource.data.joined == resource.data.joined + 1
        && !exists(/databases/$(database)/documents/invites/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/invites/$(request.auth.uid)).data.by == code;
      allow delete: if false;
    }

    match /invites/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['by', 'at'])
        && request.resource.data.by is string
        && request.resource.data.by.matches('^i[0-9a-z]{10}$')
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.by)).data.joined
          == get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.by)).data.joined + 1;
      allow update, delete: if false;
    }

    function publicGarden() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ownerUid', 'nick', 'beds', 'dex', 'golden', 'rainbow', 'titles', 'room', 'news', 'accept', 'showIlchon', 'guestbook', 'ilchonList', 'updatedAt'])
        && d.nick is string
        && d.nick.size() >= 1
        && d.nick.size() <= 12
        && d.beds is list
        && d.beds.size() <= 12
        && d.dex is int && d.dex >= 0 && d.dex <= 5000
        && d.golden is int && d.golden >= 0 && d.golden <= 5000
        && d.rainbow is int && d.rainbow >= 0 && d.rainbow <= 5000
        && (!('titles' in d) || publicTitles(d.titles))
        && (!('room' in d) || publicRoom(d.room))
        && publicIlchon(d)
        && d.updatedAt == request.time;
    }

    // 1촌 칸(docs/garden-miniroom.md §5.5). 모두 없어도 된다(옛 화면). 소식은 종류 번호 목록 5개까지,
    // 1촌 목록은 주인이 보이기를 켰을 때만 50개까지. 값은 ilchon/rules.ts의 NEWS_MAX·ILCHON_MAX와 같다.
    function publicIlchon(d) {
      return (!('news' in d) || (d.news is list && d.news.size() <= 5))
        && (!('accept' in d) || d.accept is bool)
        && (!('showIlchon' in d) || d.showIlchon is bool)
        && (!('guestbook' in d) || d.guestbook in ['all', 'ilchon', 'off'])
        && (!('ilchonList' in d)
          || (d.get('showIlchon', false) == true && d.ilchonList is list && d.ilchonList.size() <= 50));
    }

    // 가린 방. 1촌이 있는 방이 공개를 끄면 지우지 않고 이것으로 덮는다 — 방·텃밭은 걷어 낸다.
    // 규칙은 누구나 읽는 문서의 칸을 숨기지 못하므로, 숨길 것은 문서에서 빼야 한다.
    function hiddenGarden() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ownerUid', 'hidden', 'updatedAt'])
        && d.hidden == true
        && d.updatedAt == request.time;
    }

    // 내 방(docs/garden-miniroom.md §4.4). 키와 크기만 본다 — 목록 안의 값은 규칙이 하나하나 보지 못한다.
    // 화면이 가구표·품종표에 있는 id만 그린다. 액자는 쪽지 id만 싣고 글은 싣지 않는다.
    // 값은 src/features/garden/room/rules.ts의 PUBLIC_PLACED_MAX·PUBLIC_ID_MAX와 같다(room/rules.test.ts가 본다).
    function publicRoom(r) {
      return r is map
        && r.keys().hasOnly(['size', 'wall', 'floor', 'mood', 'placed'])
        && r.size is int && r.size >= 0 && r.size <= 2
        && r.wall is string && r.wall.size() <= 40
        && r.floor is string && r.floor.size() <= 40
        && r.mood is string && r.mood.size() <= 40
        && r.placed is list && r.placed.size() <= 40;
    }

    // 칭호 단계(0~3)만. 이름은 화면이 정해 둔 표에서 읽는다 — 사람이 지은 글이 아니다.
    function publicTitles(t) {
      return t is map
        && t.keys().hasOnly(['dex', 'storm', 'plaza'])
        && t.get('dex', 0) is int && t.get('dex', 0) >= 0 && t.get('dex', 0) <= 3
        && t.get('storm', 0) is int && t.get('storm', 0) >= 0 && t.get('storm', 0) <= 3
        && t.get('plaza', 0) is int && t.get('plaza', 0) >= 0 && t.get('plaza', 0) <= 3;
    }

    match /plazaRaids/{raidId} {
      allow read: if true;

      allow create: if request.auth != null
        && raidId.matches('^[0-9]{5}-[1-5]$')
        && raidDay(raidId) == kstDayNumber()
        && raidOpened(raidId)
        && request.resource.data.keys().hasOnly(['hp', 'hits', 'fighters', 'spawnedAt', 'defeatedAt'])
        && request.resource.data.hp is int
        && request.resource.data.hp >= 270
        && request.resource.data.hp <= 3000
        && request.resource.data.hits == 0
        && request.resource.data.fighters == 0
        && request.resource.data.spawnedAt == request.time
        && request.resource.data.defeatedAt == null
        && (raidWave(raidId) == 1 || raidPrevDone(raidId));

      // 쓰러뜨리기: 합계(옛 몫 hits + 칸 8개)가 체력에 닿았을 때 쓰러진 시각만 한 번 찍는다.
      allow update: if request.auth != null
        && resource.data.defeatedAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['defeatedAt'])
        && request.resource.data.defeatedAt == request.time
        && resource.data.hits + raidShardHits(raidId) >= resource.data.hp;

      // 칸 이전(2026-11-06 전)에 연 탭의 한 방(물결 문서를 직접 1씩 올림). 그 화면은 막히면 끝없이
      // 다시 보내므로 남겨 둔다. 한 사람 60번·1:1이라 불변식(혼자·둘이 못 잡음)에 닿지 않는다.
      // garden:stats의 "옛 길로 들어온 물결"이 0으로 이어지면 지운다(docs/garden-miniroom.md 배포 메모).
      allow update: if request.auth != null
        && resource.data.defeatedAt == null
        && request.time < resource.data.spawnedAt + duration.value(3, 'h')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hits', 'fighters', 'defeatedAt'])
        && request.resource.data.hits == resource.data.hits + 1
        && request.resource.data.hits <= resource.data.hp
        && request.resource.data.defeatedAt == (request.resource.data.hits == resource.data.hp ? request.time : null)
        && !('shard' in getAfter(raidFighter(raidId)).data)
        && getAfter(raidFighter(raidId)).data.lastAt == request.time
        && request.resource.data.fighters == resource.data.fighters + (exists(raidFighter(raidId)) ? 0 : 1);

      allow delete: if false;

      // 맞은 수를 나눠 세는 칸. 한 번 치거나 지원할 때 내 표식과 내 칸(표식의 shard)을 같은 커밋에서 쓴다.
      // 얼마나 오르는지는 표식 규칙이 맞춘다(표식이 오른 만큼 칸도 올라야 한다). 여기서는 상한과 짝만.
      match /shards/{n} {
        allow read: if true;
        allow create: if request.auth != null
          && n.matches('^[0-7]$')
          && request.resource.data.keys().hasOnly(['hits', 'fighters', 'names', 'aid', 'aidAt', 'aidBy'])
          && getAfter(raidPath(raidId)).data.defeatedAt == null
          && ((request.resource.data.keys().hasOnly(['hits', 'fighters'])
              && request.resource.data.hits == 0
              && request.resource.data.fighters == 0)
            || (request.resource.data.hits is int
              && request.resource.data.hits >= 0
              && request.resource.data.hits <= 40
              && request.resource.data.fighters == (exists(raidFighter(raidId)) ? 0 : 1)
              && raidShardExtras(raidId, {})
              && raidShardPaired(raidId, n)));
        allow update: if request.auth != null
          && request.resource.data.keys().hasOnly(['hits', 'fighters', 'names', 'aid', 'aidAt', 'aidBy'])
          && request.resource.data.hits is int
          && request.resource.data.hits >= resource.data.hits
          && request.resource.data.hits <= resource.data.hits + 40
          && request.resource.data.fighters == resource.data.fighters + (exists(raidFighter(raidId)) ? 0 : 1)
          && raidShardExtras(raidId, resource.data)
          && raidShardPaired(raidId, n);
        allow delete: if false;
      }

      match /fighters/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['hits', 'uses', 'lastAt', 'shard', 'aid', 'aidAt', 'aids'])
          && request.resource.data.lastAt == request.time
          && request.resource.data.hits is int
          && (resource == null || request.time > resource.data.lastAt + duration.value(1, 's'))
          && raidLive(raidId)
          && ('uses' in request.resource.data ? raidMove(raidId) : raidOldStrike(raidId));
        allow delete: if false;
      }
    }

    function raidPath(raidId) {
      return /databases/$(database)/documents/plazaRaids/$(raidId);
    }

    function raidShardPath(raidId, n) {
      return /databases/$(database)/documents/plazaRaids/$(raidId)/shards/$(n);
    }

    // 쓰러지지 않았고 도망가지 않았다.
    function raidLive(raidId) {
      let raid = get(raidPath(raidId)).data;
      return raid.defeatedAt == null
        && request.time < raid.spawnedAt + duration.value(3, 'h');
    }

    // 빈틈(rules.ts의 raidGapAt). 분이 0–2·30–32, 폭주(도망 30분 전부터)면 0–5·30–35.
    // 한국 시각과 UTC는 9시간 차이라 분이 같다. 체력 270 아래(2.0 이전에 태어난) 물결에는 빈틈이 없다.
    function raidGap(raid) {
      let m = request.time.minutes() % 30;
      return raid.hp >= 270
        && (m < 3 || (m < 6 && request.time >= raid.spawnedAt + duration.value(150, 'm')));
    }

    // 지금 화면의 한 커밋: 치기(기력 1–20, 빈틈이면 두 배를 센다) 또는 지원(센 값 그대로).
    // 기력(uses)이 없는 옛 표식은 센 값이 곧 쓴 기력이다 — 옛 화면은 한 번을 1로만 셌다.
    function raidMove(raidId) {
      let d = request.resource.data;
      let was = resource == null ? {} : resource.data;
      let hitsWas = was.get('hits', 0);
      let usesWas = was.get('uses', hitsWas);
      let used = d.uses - usesWas;
      let raid = get(raidPath(raidId)).data;
      let cell = raidShardPath(raidId, string(d.shard));
      return d.uses is int
        && d.uses <= 60
        && d.shard is int
        && d.shard >= 0
        && d.shard <= 7
        && getAfter(cell).data.hits == (exists(cell) ? get(cell).data.hits : 0) + (d.hits - hitsWas)
        && getAfter(raidPath(raidId)).data.hits == raid.hits
        && ((used >= 1
            && used <= 20
            && d.hits == hitsWas + used * (raidGap(raid) ? 2 : 1)
            && d.get('aid', 0) == was.get('aid', 0)
            && d.get('aidAt', null) == was.get('aidAt', null)
            && d.get('aids', 0) == was.get('aids', 0))
          || (used == 0
            && d.hits == hitsWas
            && d.aid in [1, 2, 3]
            && d.aidAt == request.time
            && (!('aidAt' in was) || request.time > was.aidAt + duration.value(20, 's'))
            && d.aids == was.get('aids', 0) + 1));
    }

    // 2.0 이전 화면의 한 방(uses 없음). 한 번 = 1, 한 커밋에 20까지, 60까지.
    // 칸이 있으면 내 칸이 같은 만큼 오르고 물결 문서는 그대로, 없으면(칸 이전 화면) 물결 문서가 1 오른다.
    function raidOldStrike(raidId) {
      let d = request.resource.data;
      let before = resource == null ? 0 : resource.data.hits;
      return d.keys().hasOnly(['hits', 'lastAt', 'shard'])
        && request.resource.data.hits > before
        && request.resource.data.hits <= (resource == null ? 0 : resource.data.hits) + 20
        && request.resource.data.hits <= 60
        && ('shard' in d
          ? d.shard is int
            && d.shard >= 0
            && d.shard <= 7
            && getAfter(raidShardPath(raidId, string(d.shard))).data.hits
              == (exists(raidShardPath(raidId, string(d.shard))) ? get(raidShardPath(raidId, string(d.shard))).data.hits : 0) + (d.hits - before)
            && getAfter(raidPath(raidId)).data.hits == get(raidPath(raidId)).data.hits
          : d.hits == before + 1
            && getAfter(raidPath(raidId)).data.hits == get(raidPath(raidId)).data.hits + 1);
    }

    // 칸의 이름·지원. 이름은 내 표식이 처음 생기는 커밋에서만 한 줄(12자) 붙고, 칸마다 30까지.
    // 지원은 그대로이거나, 이 커밋에서 내 표식에 건 지원과 같다. 셋은 함께 있거나 함께 없다.
    // 옛 화면은 칸을 {hits, fighters}로 통째로 쓴다 — 이름·지원이 빠지는 것은 받는다.
    function raidShardExtras(raidId, before) {
      let d = request.resource.data;
      let mine = getAfter(raidFighter(raidId)).data;
      let names = d.get('names', []);
      let had = before.get('names', []);
      return ('aid' in d) == ('aidAt' in d)
        && ('aid' in d) == ('aidBy' in d)
        && (!('names' in d)
          || names == had
          || (!exists(raidFighter(raidId))
            && names is list
            && names.size() == had.size() + 1
            && names.size() <= 30
            && (had.size() == 0 || names[0:had.size()] == had)
            && names[had.size()] is string
            && names[had.size()].size() >= 1
            && names[had.size()].size() <= 12))
        && (!('aid' in d)
          || (d.aid == before.get('aid', 0) && d.aidAt == before.get('aidAt', null) && d.aidBy == before.get('aidBy', ''))
          || (d.aid == mine.get('aid', 0)
            && d.aidAt == request.time
            && mine.get('aidAt', null) == request.time
            && d.aidBy is string
            && d.aidBy.size() >= 1
            && d.aidBy.size() <= 12));
    }

    // 이 칸을 쓰는 커밋에 내 표식도 함께 썼고, 그 표식이 이 칸을 가리킨다.
    function raidShardPaired(raidId, n) {
      let mine = getAfter(raidFighter(raidId)).data;
      return mine.lastAt == request.time && 'shard' in mine && string(mine.shard) == n;
    }

    // 칸 8개의 합. 칸이 하나라도 없으면 읽기가 실패해 거절된다 — 쓰러뜨리는 커밋이 빈 칸을 함께 만든다.
    function raidShardHits(raidId) {
      return getAfter(raidShardPath(raidId, '0')).data.hits
        + getAfter(raidShardPath(raidId, '1')).data.hits
        + getAfter(raidShardPath(raidId, '2')).data.hits
        + getAfter(raidShardPath(raidId, '3')).data.hits
        + getAfter(raidShardPath(raidId, '4')).data.hits
        + getAfter(raidShardPath(raidId, '5')).data.hits
        + getAfter(raidShardPath(raidId, '6')).data.hits
        + getAfter(raidShardPath(raidId, '7')).data.hits;
    }

    function raidFighter(raidId) {
      return /databases/$(database)/documents/plazaRaids/$(raidId)/fighters/$(request.auth.uid);
    }

    function raidDay(raidId) {
      return int(raidId.split('-')[0]);
    }

    function raidWave(raidId) {
      return int(raidId.split('-')[1]);
    }

    // 앞 물결이 끝나고 30분이 지났다. 끝남 = 쓰러졌거나, 태어나고 3시간이 지나 도망갔다.
    function raidPrevDone(raidId) {
      let prev = get(/databases/$(database)/documents/plazaRaids/$(raidId.split('-')[0] + '-' + string(raidWave(raidId) - 1))).data;
      return prev.defeatedAt != null
        ? request.time > prev.defeatedAt + duration.value(30, 'm')
        : request.time > prev.spawnedAt + duration.value(210, 'm');
    }

    // 이 물결이 열리는 시각(한국 시각 8·11·14·17·20시)이 됐다. 기기 시계가 어긋난 몫으로 5분을 봐준다.
    // 여는 시각이 없으면 앞 물결이 빨리 쓰러질 때 다음이 줄줄이 나와 오전에 몰린다.
    function raidOpened(raidId) {
      return request.time.toMillis() + 300000
        >= raidDay(raidId) * 86400000 - 32400000 + (8 + 3 * (raidWave(raidId) - 1)) * 3600000;
    }

    match /plazaDays/{day} {
      allow read: if true;
      allow create, update: if request.auth != null
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['pulls', 'gardeners', 'lastCell'])
        && request.resource.data.lastCell is string
        && request.resource.data.lastCell.matches('^c[0-9]{2}$')
        && request.resource.data.pulls == (resource == null ? 0 : resource.data.pulls) + 1
        && getAfter(/databases/$(database)/documents/plazaCells/$(request.resource.data.lastCell)).data.pulledAt == request.time
        && (
          request.resource.data.gardeners == (resource == null ? 0 : resource.data.gardeners)
          || (
            request.resource.data.gardeners == (resource == null ? 0 : resource.data.gardeners) + 1
            && !exists(/databases/$(database)/documents/plazaDays/$(day)/gardeners/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/plazaDays/$(day)/gardeners/$(request.auth.uid))
          )
        );
      allow delete: if false;

      match /gardeners/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if false;
      }
    }


    /*
     * 피드백 — 이 저장소에서 **공개로 읽는 유일한 것**이다.
     *
     * 공개인 것이 기능이다. 남들이 무엇을 남겼는지 보이지 않으면 같은 말이
     * 계속 쌓인다. 그래서 목록은 누구나 읽고, 같은 생각이면 새로 쓰는 대신
     * '나도요'를 누르게 한다.
     *
     * 익명이다. authorUid는 본인 삭제와 중복 '나도요'를 막는 데만 쓰고 화면에
     * 내보내지 않는다. 다만 **규칙이 익명성을 보장하지는 않는다** — 문서를
     * 직접 읽으면 uid가 보인다. 화면에 이름이 안 뜬다는 뜻이지 uid가 비밀이라는
     * 뜻이 아니며, 그래서 uid로 사람을 되짚을 수 있는 것을 넣지 않는다.
     */
    match /feedback/{id} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 1000
        && request.resource.data.kind in ['bug', 'idea', 'content', 'etc']
        // 새 글은 늘 같은 자리에서 시작한다. 상태와 답변은 운영자만 만진다.
        && request.resource.data.status == 'open'
        && request.resource.data.agreeCount == 0
        && request.resource.data.reply == null;

      // 제 글은 지울 수 있다. 운영자는 무엇이든 지운다.
      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());

      allow update: if isAdmin()
        ? request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reply', 'repliedAt'])
          && request.resource.data.status in ['open', 'planned', 'done', 'wontfix']
        : isAgreeDelta(
            /databases/$(database)/documents/feedback/$(id)/agrees/$(request.auth.uid)
          );

      /*
       * 나도요. 한 사람이 한 번만 누르도록 uid를 문서 id로 쓴다.
       * 카운터는 부모 문서에 있고, 위 isAgreeDelta가 이 문서와 짝이 맞는지 본다.
       */
      match /agrees/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    /*
     * 정정·반론 접수 (검토 문서 3장).
     *
     * ★ 피드백과 반대로, 여기는 공개가 아닌 것이 기능이다.
     *   실린 내용이 틀렸다는 주장은 대개 남에 대한 이야기를 담는다. 공개
     *   게시판에 두면 그 글 자체를 이 사이트가 싣게 되고, 접수함이 아니라
     *   또 하나의 발행면이 된다. 그래서 본인과 운영자만 읽는다.
     *
     * 지우는 것은 본인과 운영자 둘 다 할 수 있다. 접수 기록을 남기는 편이
     * 방어에는 낫지만, 제가 쓴 글을 거둘 수 없게 만들면서 연락처까지 받는
     * 창구는 만들지 않는다.
     */
    match /corrections/{id} {
      allow read: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 10
        && request.resource.data.body.size() <= 2000
        && request.resource.data.kind in ['fact', 'rebuttal', 'takedown']
        && request.resource.data.role in ['subject', 'related', 'reader']
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 300
        && request.resource.data.evidenceUrl is string
        && request.resource.data.evidenceUrl.size() <= 500
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 200
        // 새 접수는 늘 같은 자리에서 시작한다. 상태를 옮기는 것은 운영자다.
        && request.resource.data.status == 'received';

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'note', 'handledAt'])
        && request.resource.data.status in ['received', 'checking', 'fixed', 'declined'];

      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    /*
     * 지지자 응원 — 영상.
     *
     * ★ 문서 id가 곧 유튜브 영상 id다.
     *   같은 영상이 두 번 올라오는 것을 규칙이나 화면이 아니라 **저장소가**
     *   막는다. 필드로 두면 목록을 다 읽어 봐야 알 수 있고, 두 사람이 같은
     *   순간에 올리면 둘 다 통과한다.
     *
     * ★ 제목과 채널은 규칙이 보증하지 못한다.
     *   화면은 /api/youtube가 준 것을 그대로 올리지만, 규칙이 볼 수 있는 것은
     *   길이뿐이다. 거짓 제목을 붙인 문서를 손으로 만들 수는 있다는 뜻이다.
     *   그래서 운영자가 내릴 수 있게 해 두었고, 그게 여기서 감당하는 방식이다.
     */
    /*
     * 응원이 가리키는 언행(topic) — 없어도 되고, 있으면 언행 slug 모양이어야 한다.
     * 실제로 있는 언행인지는 규칙이 모른다. 화면은 아는 slug만 붙이고, 모르는 이름표는
     * 그리지 않는다. 이름표일 뿐이라 원문 화면에는 아무것도 실리지 않는다.
     */
    function cheerTopicOk(data) {
      return !('topic' in data)
        || (data.topic is string && data.topic.matches('^[a-z0-9-]{1,80}$'));
    }

    match /cheerVideos/{youtubeId} {
      allow read: if true;

      allow create: if request.auth != null
        && youtubeId.matches('^[A-Za-z0-9_-]{11}$')
        && request.resource.data.youtubeId == youtubeId
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.channel is string
        && request.resource.data.channel.size() > 0
        && request.resource.data.channel.size() <= 100
        && cheerTopicOk(request.resource.data);

      // 올린 사람은 제 것을 거둘 수 있고, 운영자는 무엇이든 내린다.
      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());

      /*
       * 한 번 걸린 영상은 고쳐지지 않는다. 내리고 다시 올린다.
       * 이 한 줄이 겹침 방지이기도 하다 — setDoc이 덮어쓰려 들면 여기서 막힌다.
       */
      allow update: if false;
    }

    /*
     * 지지자 응원 — 한 줄.
     *
     * ★ 80자다. 이 숫자가 설계 전부다.
     *   한 줄로는 남을 헐뜯거나 논쟁을 벌일 수 없고, 운영자가 한 건 읽는 데
     *   2초면 된다. 길이를 늘리는 순간 이것은 응원판이 아니라 정치 게시판이
     *   되고, 그때부터 옆 탭에 있는 근거까지 같이 의심받는다.
     *
     * ★ 답글이 없다. 오가는 말이 생기면 그것도 게시판이다.
     *   그래서 여기 update로 열려 있는 것은 '나도요' 카운터뿐이다 — 운영자도
     *   남의 글을 고치지 못하고, 지울 수만 있다.
     */
    match /cheerNotes/{id} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 80
        && request.resource.data.agreeCount == 0
        && cheerTopicOk(request.resource.data);

      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());

      allow update: if isAgreeDelta(
        /databases/$(database)/documents/cheerNotes/$(id)/agrees/$(request.auth.uid)
      );

      match /agrees/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    /*
     * 업적 인포그래픽 — 구글 계정을 연결한 사람이 올리고, 운영자가 승인한 것만 싣는다.
     *
     * ★ 새 그림은 늘 승인 대기로 시작한다.
     *   업적 페이지는 근거가 붙은 것만 싣는 자리다. 올리자마자 보이면 확인하지
     *   않은 숫자가 업적과 같은 층에 선다. status를 옮기는 것은 운영자뿐이다.
     *
     * ★ 승인 대기인 것은 올린 사람과 운영자만 읽는다.
     *   목록 조회가 이 규칙을 통과하려면 쿼리가 status나 authorUid로 걸러야
     *   한다. 화면은 셋 중 하나로만 묻는다 — 실린 것, 내 것, 대기열(운영자).
     *
     * ★ 올리는 것은 구글 계정을 연결한 사람뿐이다(hasGoogle).
     *
     * ★ 그림 경로는 올린 사람과 문서 id로 정해진다.
     *   Storage 규칙이 경로의 uid로 주인을 가리므로, 문서가 남의 경로를
     *   가리키지 못하게 여기서 맞춘다.
     */
    /*
     * 구글 계정을 연결했는가. 익명 계정에서 연결한 경우에도 identities에
     * google.com이 들어간다. 익명 계정은 브라우저를 지우면 사라지는
     * 일회용이라, 내려야 할 그림을 올린 사람을 되짚을 수 없다.
     */
    function hasGoogle() {
      return request.auth != null
        && 'google.com' in request.auth.token.firebase.identities;
    }

    match /infographics/{id} {
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && resource.data.authorUid == request.auth.uid)
        || isAdmin();

      allow create: if hasGoogle()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        // 그림만 있으면 된다. 제목과 설명은 비워 둘 수 있다.
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.alt is string
        && request.resource.data.alt.size() <= 3000
        // 등록자 이름은 고를 수 있다. 적었다면 30자까지.
        && (request.resource.data.get('authorName', null) == null
          || (request.resource.data.authorName is string
            && request.resource.data.authorName.size() > 0
            && request.resource.data.authorName.size() <= 30))
        && request.resource.data.imagePath == 'infographics/' + request.auth.uid + '/' + id
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2000
        && request.resource.data.width is int
        && request.resource.data.width > 0
        && request.resource.data.height is int
        && request.resource.data.height > 0;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'approvedAt'])
        && request.resource.data.status in ['pending', 'approved'];

      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    /*
     * 운영자 명단. 콘솔에서 손으로 넣는다.
     *
     * 자기 문서만 읽게 해서 "내가 운영자인가"만 확인할 수 있고 명단 전체는
     * 볼 수 없다. 쓰기는 아무에게도 열지 않는다 — 콘솔로만 바꾼다.
     */
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // 그 밖의 모든 것은 닫는다. 열어야 할 것이 생기면 그때 이름을 적는다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
