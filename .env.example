# ── AI 안내 (선택) ───────────────────────────────────────────
#
# 이 값이 없어도 앱 전체가 정상 동작한다. 지도·연표·관계도·근거는
# AI를 쓰지 않는다. 키가 없으면 "AI에게 묻기"만 안내 문구를 띄운다.
#
# 발급: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# 안내에 쓸 모델. 생략하면 claude-haiku-4-5.
# 이 경로가 하는 일은 대부분 '어느 화면을 보여줄지' 고르는 것이라
# 저비용 모델로 충분하다 (설계서 14장 모델 라우터의 첫 단계).
#   claude-haiku-4-5 기본. 질문 1회 4원 안팎
#   claude-opus-5    판단이 가장 정확하다. 질문 1회 20원 안팎
# 주의: effort 파라미터는 Haiku에서 400을 낸다. 코드가 모델을 보고 갈라준다.
# ASK_MODEL=claude-opus-5

# 위키 질의(/api/wiki-ask)에 쓸 모델. 생략하면 ASK_MODEL, 그것도 없으면
# claude-haiku-4-5. 이쪽은 위키 여러 장을 읽고 앵커를 그대로 옮겨야 해서
# 화면 안내보다 판단이 더 필요하다. 배포 기본값은 apphosting.yaml에 있다.
#   claude-sonnet-5  배포 기본값
WIKI_ASK_MODEL=claude-sonnet-5

# ── 사이트 주소 (선택) ───────────────────────────────────────
#
# OG 이미지와 공유 링크의 기준 주소. 생략하면 https://jamtong.kr
# 미리보기 배포에서는 그 배포 주소로 덮어쓴다.
# NEXT_PUBLIC_SITE_URL=https://jamtong.kr

# ── AI 안내 남용 방지 (선택) ─────────────────────────────────
#
# 공개된 엔드포인트는 누구나 운영자 돈으로 호출할 수 있다.
# 아래는 코드 쪽 방어선이고, 마지막 상한은 코드가 아니다 —
# Anthropic Console에서 API 키에 월 지출 한도를 걸어 두는 것이
# 유일하게 확실한 천장이다.

# 한 IP가 1시간에 물을 수 있는 횟수. 생략하면 20
# ASK_IP_LIMIT=20

# 하루 전체 모델 호출 상한. 생략하면 500 (Haiku 기준 약 2,000원)
# 넘으면 AI 안내만 조용히 멈추고 나머지 기능은 그대로 동작한다.
# ASK_DAILY_LIMIT=500
